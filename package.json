{
  "name": "ape",
  "version": "2.24.8",
  "type": "module",
  "private": true,
  "description": "APE — durable, evidence-gated engineering runs for AI coding agents",
  "author": {
    "name": "AAWWCC",
    "url": "https://github.com/AAWWCC"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "mcp",
    "plugin",
    "pipeline",
    "build",
    "ship",
    "plan",
    "resumable",
    "tdd",
    "verification",
    "autonomous",
    "ape"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AAWWCC/ape.git"
  },
  "bugs": {
    "url": "https://github.com/AAWWCC/ape/issues"
  },
  "homepage": "https://github.com/AAWWCC/ape#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:agent": "vitest run --maxWorkers=3",
    "test:watch": "vitest",
    "test:v2": "vitest run runtime-v2-",
    "test:structured-remediation": "vitest run __tests__/runtime-v2-bounded-summary-control-characters.test.js __tests__/runtime-v2-core-land-lane.test.js __tests__/runtime-v2-evidence-channel-residuals.test.js __tests__/runtime-v2-evidence-character-allowlist.test.js __tests__/runtime-v2-forwarded-channel-disclosure.test.js __tests__/runtime-v2-prose-bound-bypass-routes.test.js __tests__/runtime-v2-remediation-review-findings.test.js __tests__/runtime-v2-remediation-test-path-routing.test.js __tests__/runtime-v2-retry-remediation-evidence.test.js __tests__/runtime-v2-review-findings-ticket-notice.test.js __tests__/runtime-v2-root-test-claim-widening.test.js __tests__/runtime-v2-scope-expanded-receipt-atomicity.test.js __tests__/runtime-v2-scope-expansion.test.js __tests__/runtime-v2-structured-remediation-routing.test.js __tests__/runtime-v2-test-scope-directory-widening.test.js",
    "test:claude-schema": "node scripts/run-claude-schema-calibration.mjs",
    "test:timings": "node scripts/update-test-durations.mjs",
    "eval:prompts:check": "node evals/prompt-evals.mjs check",
    "eval:prompts:plan": "node evals/prompt-evals.mjs plan",
    "eval:prompts:run": "node evals/prompt-evals.mjs run",
    "eval:prompts:verify": "node evals/prompt-evals.mjs verify",
    "operational:canary": "node scripts/run-operational-canaries.mjs",
    "release:live-preflight": "node scripts/check-live-certification-environment.mjs",
    "release:live-prompts": "node scripts/prepare-live-certification-prompts.mjs",
    "release:live-parent": "node scripts/run-live-certification-parent.mjs",
    "release:worker-validator-reachability": "node scripts/run-worker-validator-reachability.mjs",
    "release:worker-validator-proof": "node scripts/run-worker-validator-reachability.mjs --verify-proof",
    "release:live-certification": "node scripts/verify-live-certification.mjs",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "bundle": "node scripts/bundle-mcp.mjs",
    "bundle:check": "vitest run __tests__/runtime-v2-bundle-freshness.test.js",
    "bundle:reach": "node scripts/bundle-reach.mjs",
    "compatibility:check": "node scripts/check-host-compatibility.mjs",
    "docs:config": "node scripts/generate-config-docs.mjs",
    "docs:check": "node scripts/generate-config-docs.mjs --check",
    "package:plugins": "node scripts/build-plugin-packages.mjs",
    "package:check": "npm run docs:check && npm run bundle:check && node scripts/build-plugin-packages.mjs --check",
    "package:reproducible": "node scripts/check-plugin-reproducibility.mjs",
    "release:artifacts": "node scripts/build-release-artifacts.mjs",
    "release:reproducible": "node scripts/check-release-reproducibility.mjs",
    "public:check": "node scripts/check-public-surface.mjs && node scripts/check-public-commit-identities.mjs",
    "public:identity": "node scripts/check-public-commit-identities.mjs",
    "public:hooks": "node scripts/install-public-hooks.mjs",
    "public:export": "node scripts/export-public-tree.mjs",
    "smoke:plugins": "node scripts/smoke-plugin-mcp.mjs",
    "smoke:marketplaces": "node scripts/smoke-marketplace-install.mjs",
    "reinstall:codex": "node scripts/reinstall-codex-plugin.mjs",
    "statusline:svg": "node scripts/render-statusline-svg.mjs",
    "benchmark:verify": "node scripts/benchmark-v2.mjs",
    "validate:claude": "claude plugin validate ./plugins/ape-claude && claude plugin validate ./plugins/ape-claude --strict",
    "validate:codex": "node scripts/smoke-marketplace-install.mjs --host codex",
    "validate": "npm run validate:claude && npm run validate:codex"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "fast-check": "^4.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
