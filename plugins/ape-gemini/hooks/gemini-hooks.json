{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node --input-type=module -e \"process.env.APE_HOST='gemini';process.env.APE_HOOK_EVENT='PreToolUse';await import('./dist/ape-hooks.bundle.mjs')\"",
            "commandWindows": "node --input-type=module -e \"process.env.APE_HOST='gemini';process.env.APE_HOOK_EVENT='PreToolUse';await import('./dist/ape-hooks.bundle.mjs')\"",
            "timeout": 30,
            "statusMessage": "Checking APE stage ticket"
          }
        ]
      },
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "node --input-type=module -e \"process.env.APE_HOST='gemini';process.env.APE_HOOK_EVENT='PreToolUse';await import('./dist/ape-larp.bundle.mjs')\"",
            "commandWindows": "node --input-type=module -e \"process.env.APE_HOST='gemini';process.env.APE_HOOK_EVENT='PreToolUse';await import('./dist/ape-larp.bundle.mjs')\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node --input-type=module -e \"process.env.APE_HOST='gemini';process.env.APE_HOOK_EVENT='PreInvocation';await import('./dist/ape-hooks.bundle.mjs')\"",
        "commandWindows": "node --input-type=module -e \"process.env.APE_HOST='gemini';process.env.APE_HOOK_EVENT='PreInvocation';await import('./dist/ape-hooks.bundle.mjs')\"",
        "timeout": 30,
        "statusMessage": "Binding APE stage ticket"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node --input-type=module -e \"process.env.APE_HOST='gemini';process.env.APE_HOOK_EVENT='PostToolUse';await import('./dist/ape-hooks.bundle.mjs')\"",
            "commandWindows": "node --input-type=module -e \"process.env.APE_HOST='gemini';process.env.APE_HOOK_EVENT='PostToolUse';await import('./dist/ape-hooks.bundle.mjs')\"",
            "timeout": 30,
            "statusMessage": "Verifying APE tree ownership"
          }
        ]
      },
      {
        "matcher": "(?:^|__)ape_run$",
        "hooks": [
          {
            "type": "command",
            "command": "node --input-type=module -e \"process.env.APE_HOST='gemini';process.env.APE_HOOK_EVENT='PostToolUse';await import('./dist/ape-larp.bundle.mjs')\"",
            "commandWindows": "node --input-type=module -e \"process.env.APE_HOST='gemini';process.env.APE_HOOK_EVENT='PostToolUse';await import('./dist/ape-larp.bundle.mjs')\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node --input-type=module -e \"process.env.APE_HOST='gemini';process.env.APE_HOOK_EVENT='Stop';await import('./dist/ape-hooks.bundle.mjs')\"",
        "commandWindows": "node --input-type=module -e \"process.env.APE_HOST='gemini';process.env.APE_HOOK_EVENT='Stop';await import('./dist/ape-hooks.bundle.mjs')\"",
        "timeout": 30,
        "statusMessage": "Verifying APE run state"
      },
      {
        "type": "command",
        "command": "node --input-type=module -e \"process.env.APE_HOST='gemini';process.env.APE_HOOK_EVENT='Stop';await import('./dist/ape-larp.bundle.mjs')\"",
        "commandWindows": "node --input-type=module -e \"process.env.APE_HOST='gemini';process.env.APE_HOOK_EVENT='Stop';await import('./dist/ape-larp.bundle.mjs')\"",
        "timeout": 5
      }
    ]
  }
}
