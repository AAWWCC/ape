{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./dist/ape-hooks.bundle.mjs PreToolUse",
            "timeout": 30,
            "statusMessage": "Checking APE stage ticket"
          }
        ]
      },
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "node ./dist/ape-larp.bundle.mjs PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./dist/ape-hooks.bundle.mjs PreInvocation",
        "timeout": 30,
        "statusMessage": "Binding APE stage ticket"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./dist/ape-hooks.bundle.mjs PostToolUse",
            "timeout": 30,
            "statusMessage": "Verifying APE tree ownership"
          }
        ]
      },
      {
        "matcher": "(?:^|__)ape_run$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./dist/ape-larp.bundle.mjs PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./dist/ape-hooks.bundle.mjs Stop",
        "timeout": 30,
        "statusMessage": "Verifying APE run state"
      },
      {
        "type": "command",
        "command": "node ./dist/ape-larp.bundle.mjs Stop",
        "timeout": 5
      }
    ]
  }
}
