{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AAWWCC/ape/blob/main/evals/live-certification.schema.json",
  "title": "APE live release certification ledger",
  "description": "Privacy-safe first-pass-perfect Codex outcomes for the offline tagged-release certification gate, with the packaged but operationally unverified Claude host named explicitly. Cross-record ancestry, exact coverage, ordering, and zero-retry rules are enforced by scripts/verify-live-certification.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ape_version",
    "source_commit",
    "certified_hosts",
    "unverified_hosts",
    "terminal_reason_taxonomy_version",
    "attempts"
  ],
  "properties": {
    "schema_version": {
      "const": 5
    },
    "ape_version": {
      "$ref": "#/$defs/version"
    },
    "source_commit": {
      "$ref": "#/$defs/commit"
    },
    "certified_hosts": {
      "const": [
        "codex"
      ],
      "description": "Hosts whose authenticated live execution is required and certified by this ledger."
    },
    "unverified_hosts": {
      "const": [
        "claude"
      ],
      "description": "Packaged hosts that have structural and marketplace validation but no authenticated live release certification."
    },
    "terminal_reason_taxonomy_version": {
      "const": 2
    },
    "attempts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/attempt"
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"
    },
    "terminal_reason_code": {
      "enum": [
        "completed",
        "aborted",
        "aborted_dispatch",
        "aborted_preflight",
        "aborted_planning",
        "aborted_test",
        "aborted_implementation",
        "aborted_review",
        "aborted_gating",
        "aborted_shipping",
        "aborted_investigation",
        "aborted_unclassified",
        "planning_rejected",
        "preflight_failed",
        "test_contradiction",
        "capability_blocked",
        "worker_protocol_failure",
        "dispatch_expired",
        "test_failed",
        "implementation_failed",
        "land_review_disagreement",
        "review_remediation_exhausted",
        "gate_failed",
        "shipping_hold",
        "shipping_failed",
        "stage_failed",
        "blocked_unclassified",
        "legacy_unclassified"
      ]
    },
    "protected_land": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_branch",
        "merge_method",
        "merge_path",
        "bypass_used",
        "required_checks_passed",
        "checked_head_commit",
        "gate_tree",
        "merged_tree",
        "branch_protection",
        "pr_state",
        "pushed_head_commit",
        "observed_merged_pr_head",
        "merge_commit",
        "remote_head_after_merge"
      ],
      "properties": {
        "target_branch": {
          "const": "main"
        },
        "merge_method": {
          "const": "squash"
        },
        "merge_path": {
          "enum": ["immediate", "auto"],
          "description": "The observed merge path, not a demand to force auto-merge. Auto means the retained shipping events actually enabled automatic merging; immediate means ordinary protected squash. Neither a queued command nor its exit status proves completion."
        },
        "bypass_used": {
          "const": false
        },
        "required_checks_passed": {
          "const": true
        },
        "checked_head_commit": {
          "$ref": "#/$defs/commit"
        },
        "gate_tree": {
          "$ref": "#/$defs/commit"
        },
        "merged_tree": {
          "$ref": "#/$defs/commit"
        },
        "branch_protection": {
          "$ref": "#/$defs/branch_protection"
        },
        "pr_state": {
          "const": "MERGED"
        },
        "pushed_head_commit": {
          "$ref": "#/$defs/commit"
        },
        "observed_merged_pr_head": {
          "$ref": "#/$defs/commit"
        },
        "merge_commit": {
          "$ref": "#/$defs/commit"
        },
        "remote_head_after_merge": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "branch_protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pull_request_required",
        "required_checks_strict",
        "required_checks_count",
        "admins_enforced",
        "force_pushes_allowed",
        "deletions_allowed",
        "before_sha256",
        "after_sha256"
      ],
      "properties": {
        "pull_request_required": { "const": true },
        "required_checks_strict": { "const": true },
        "required_checks_count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "admins_enforced": { "const": true },
        "force_pushes_allowed": { "const": false },
        "deletions_allowed": { "const": false },
        "before_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "certificationProtectionPolicyDigest of the externally retained complete policy immediately before shipping, including the frozen target, all required check identities and providers, bypass allowances and every effective branch restriction."
        },
        "after_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Same normalized policy observed after proven remote completion; must equal before_sha256. The operator retains both observations and their timestamps outside the public repository."
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "attempt_id",
        "host",
        "host_version",
        "plugin_version",
        "pipeline",
        "source_commit",
        "run_record_sha256",
        "ticket_count",
        "duration_ms",
        "outcome",
        "terminal_reason_code",
        "manual_intervention",
        "prompt_assembly_failure",
        "worker_tool_failure",
        "control_call_failure",
        "host_transport_retry",
        "receipt_repair",
        "duplicate_dispatch",
        "remediation",
        "self_correction",
        "abort_successor",
        "protected_land"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "attempt_id": {
          "$ref": "#/$defs/identifier"
        },
        "host": {
          "enum": [
            "codex"
          ]
        },
        "host_version": {
          "$ref": "#/$defs/version"
        },
        "plugin_version": {
          "$ref": "#/$defs/version"
        },
        "pipeline": {
          "enum": [
            "mechanical",
            "fast",
            "full",
            "protected-branch-land"
          ]
        },
        "source_commit": {
          "$ref": "#/$defs/commit"
        },
        "run_record_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of the exact privately retained archived APE run-record bytes for this attempt."
        },
        "ticket_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "outcome": {
          "enum": [
            "success",
            "failure"
          ]
        },
        "terminal_reason_code": {
          "$ref": "#/$defs/terminal_reason_code"
        },
        "manual_intervention": {
          "type": "boolean"
        },
        "prompt_assembly_failure": {
          "type": "boolean"
        },
        "worker_tool_failure": {
          "type": "boolean"
        },
        "control_call_failure": {
          "type": "boolean"
        },
        "host_transport_retry": {
          "type": "boolean"
        },
        "receipt_repair": {
          "type": "boolean"
        },
        "duplicate_dispatch": {
          "type": "boolean"
        },
        "remediation": {
          "type": "boolean"
        },
        "self_correction": {
          "type": "boolean"
        },
        "abort_successor": {
          "type": "boolean"
        },
        "protected_land": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/protected_land"
            }
          ]
        }
      }
    }
  }
}
